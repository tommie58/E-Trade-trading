# E*TRADE OAuth (get from https://developer.etrade.com)
ETRADE_CONSUMER_KEY=
ETRADE_CONSUMER_SECRET=
ETRADE_ENV=sandbox            # sandbox | live
ETRADE_ACCOUNT_ID_KEY=        # accountIdKey from GET /v1/accounts/list
# ETRADE_ACCOUNT_ID=          # optional. Prefer pinning the trading account in
#                             # the app (E*TRADE Account → Trading account) —
#                             # that pin is stored in Redis and OUTRANKS this.

# pyetrade variant only — populated by `python -m bot.pyetrade_variant.auto_trader --authorize`
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_SECRET=

# Shared secret with the Rork app (set the same value in the app's Webhook section)
WEBHOOK_SECRET=change-me

# Defensive filters — MUST mirror your Rork app settings (app defaults:
# minScore 55 / trending 50 / rvol 0.9 / mtf 1). Dispatch is gated on
# max(app, bot), so if the bot is stricter than the app, every dispatch the app
# clears is rejected server-side and NO trades flow — while the app's settings
# screen still shows the looser number. The app reads these live from /status
# and now raises a 'gate drift' incident when they disagree.
#
# THESE ENV VARS OVERRIDE THE CODE DEFAULTS. Leaving a stale MIN_SCORE=75 on the
# host keeps the gate at 75 no matter what the bot source says — this file is
# what usually re-closes the gate after a recalibration. Prefer leaving them
# UNSET and letting the bot's own defaults apply.
MIN_SCORE=55
MIN_SCORE_TRENDING=50
MIN_RVOL=0.9
MIN_MTF=1
# EMPTY = allow every classified setup (recommended). A populated list is
# opt-in and rejects anything the classifier learns to emit that is not named
# here — 'ORB' was silently refused this way. Only set it to deliberately
# restrict trading to specific setups.
ALLOWED_SETUPS=

# Risk management
ACCOUNT_SIZE=50000
RISK_PER_TRADE_PCT=0.5
DAILY_LOSS_LIMIT_PCT=2.0
MAX_CONCURRENT_POSITIONS=3
PORTFOLIO_HEAT_PCT=6.0
# There is NO daily trade-count cap. Risk is measured in DOLLARS: the daily loss
# limit above IS the day's risk budget, drawn down by realized losses AND open
# position risk. A count is a bad proxy for exposure (6 trades at 1% risk is more
# than 20 at 0.25%). The value below only catches a runaway dispatch loop, which
# is a bug rather than a trading day — leave it well above any real session.
RUNAWAY_TRADE_CIRCUIT_BREAKER=60
# Execution cost: the edge must survive the round trip. E*TRADE charges per
# contract EACH WAY, which is brutal on cheap options ($0.65 on a $0.30 contract
# is 4.3% before the spread). Entries above the cost ceiling are refused.
COMMISSION_PER_CONTRACT=0.65
MAX_ROUND_TRIP_COST_PCT=12.0
TICKER_COOLDOWN_MINUTES=15
PAPER_MODE=true

# Stop guard (live orders): entry orders with zero fill are cancelled after
# this many minutes; filled entries get a protective STOP resting at E*TRADE.
ENTRY_FILL_TIMEOUT_MIN=20
STOP_GUARD_POLL_SECONDS=10

# ==================== V5.3: STOP PLACEMENT TIMEOUT CIRCUIT BREAKER ====================
# A guarded entry must have its protective stop RESTING at the broker within
# this many seconds. The clock starts at entry placement and RE-ANCHORS to the
# first detected fill (a fill always gets the full window). At the deadline
# with no stop: unfilled entry → cancelled immediately; filled entry → live
# remainder cancelled + emergency-flattened at MARKET (a fill cannot be
# cancelled). Set 0 to disable.
STOP_PLACEMENT_TIMEOUT_SECONDS=60

# ==================== V5.3: E*TRADE API EXPONENTIAL BACKOFF ====================
# Every E*TRADE call (raw async client AND pyetrade paths) retries transient
# failures (429/408/5xx, network drops, post-renewal 401s) with exponential
# backoff: base * 2^attempt, capped. A 429 throttle waits the EXACT schedule
# (2s → 4s → 8s with the defaults, no jitter); other errors apply jitter.
# Order placement is retried ONLY on 429 (provably never processed) — any
# other failed place may still have landed at the broker.
ETRADE_RETRY_ATTEMPTS=4
ETRADE_RETRY_BASE_SECONDS=2
ETRADE_RETRY_MAX_SECONDS=8

# Legacy JSON state file — migrated into Redis once at startup, then renamed
# *.migrated. Only used as a one-time import source.
ETRADE_STATE_FILE=.etrade_state.json

# ==================== V5: DISTRIBUTED STATE (Redis) ====================
# REQUIRED for production. All positions, stop guards, daily counters, the
# kill switch, idempotency keys, cooldowns and distributed locks live here.
# Without it the bot falls back to single-process in-memory state (dev only).
REDIS_URL=

# Postgres for OAuth token persistence (falls back to local SQLite).
DATABASE_URL=

# ==================== V5: ASYNC RAW ORDER API ====================
# Primary placement path: raw JSON payloads against E*TRADE's Order API via
# httpx (async). pyetrade remains the automatic fallback.
USE_RAW_ORDER_API=true
# Attempt an atomic Entry+Stop (OTOCO-style) submission once per day. E*TRADE's
# public API doesn't officially support OCO/OTOCO — rejections fall back to
# entry + stop guard automatically.
ENABLE_RAW_OTOCO=true
OTOCO_UNSUPPORTED_TTL=86400

# ==================== V5: BACKGROUND RECONCILIATION ====================
# Pulls broker orders + positions, compares against Redis, auto-heals
# (fill sync, ghost positions, orphaned stops, unprotected → guard re-arm).
# Runs under a distributed lock — one instance reconciles at a time.
# Cadence: every 5 min in-session / 15 min off-hours — a periodic safety net,
# NOT the fast path (stop guards are event-driven). A blocking pass also runs
# at startup, before any order is accepted.
RECONCILE_INTERVAL_SECONDS=300
RECONCILE_OFFHOURS_SECONDS=900
RECONCILE_AUTO_HEAL=true
STARTUP_RECONCILE_TIMEOUT_SECONDS=90

# ==================== V5.1: REAL-TIME ALERTING ====================
# Kill switch, failed guards, unprotected positions, circuit breaker trips and
# API problems. Alerts ALWAYS land in the log and GET /alerts; set a webhook
# URL (Slack incoming webhook, Discord webhook, ntfy, or any JSON receiver)
# for instant push. Duplicate alerts are suppressed per key for the dedupe
# window below.
ALERT_WEBHOOK_URL=
ALERT_DEDUPE_SECONDS=300

# ==================== V5.1: IMMUTABLE TRADE LEDGER ====================
# Append-only, hash-chained JSONL audit trail of every order, position,
# protective stop, guard result and safety event. GET /ledger?verify=true
# walks the full chain to prove nothing was altered or removed.
TRADE_LEDGER_FILE=trade_ledger.jsonl

# ==================== V5.1: CIRCUIT BREAKER (distributed) ====================
# Order placement halts on ALL workers after this many consecutive broker API
# failures inside the rolling window; auto-resets after the cooldown (or
# instantly on account relink). Trips are alerted + ledgered.
MAX_CONSECUTIVE_FAILURES=5
BREAKER_FAILURE_WINDOW_SECONDS=600
CIRCUIT_BREAKER_COOLDOWN_SECONDS=600

# ==================== V5: OPTION STOP PROTECTION ====================
# After an option entry fills, a SELL_CLOSE STOP rests at the broker on the
# same OCC contract. The app can send an explicit `option_stop_price`
# (premium); otherwise the stop sits this % below the entry premium.
# Set 0 to disable the automatic premium-percent fallback.
OPTION_STOP_LOSS_PCT=30
# Sanity band for the app's delta-derived `option_stop_price`. The app owns the
# policy (underlying stop x delta, floored by the spread, capped at 30%); these
# only stop a bad number from resting at the broker. Out-of-band values are
# CLAMPED into the band and logged, never discarded.
#   MIN = tightest allowed risk (below this the quote alone scratches the trade)
#   MAX = widest allowed risk (above this the blind % stop was safer)
OPTION_STOP_MIN_HAIRCUT_PCT=8
OPTION_STOP_MAX_HAIRCUT_PCT=45
